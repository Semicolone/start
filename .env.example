# ======================
# Environment Variables
# ======================

# Application
DEBUG=True
API_VERSION=1.0.0

# Database (PostgreSQL - 나중에 사용)
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://flowuser:flowpassword@db:5432/flowdb

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
INTERNAL_TASK_SECRET=your-internal-task-secret-here-change-this-in-production

# Server (참고용)
# SERVER_HOST=your-server-ip
# SERVER_USER=ubuntu
# SERVER_PORT=8000

# CORS (개발용)
ALLOWED_ORIGINS=*